{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "dependencyDashboard": {
    "enabled": false
  },
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "autogov-version:\\n(?:[ \\t]+[^\\n]*\\n)*?[ \\t]+default:[ \\t]*(?<currentDigest>[0-9a-f]{40})[ \\t]*#[ \\t]*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "liatrio/autogov",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "autogov-version`[^\\n]*?default: `(?<currentDigest>[0-9a-f]{40})`, the (?<currentValue>v\\d+\\.\\d+\\.\\d+) commit"
      ],
      "depNameTemplate": "liatrio/autogov",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/rw-release-assets\\.sh$/"
      ],
      "matchStrings": [
        "assert_input_default [^\\n]* autogov-version (?<currentDigest>[0-9a-f]{40}) # (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "liatrio/autogov",
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "extends": [
        ":semanticPrefixFixDepsChoreOthers",
        "helpers:pinGitHubActionDigests"
      ],
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": false,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "autogov-version bumps must be fix:-typed so they cut a release. The rw-* defaults only reach consumers via a release tag, so a chore:-typed bump merges to main and stops there -- which is how the pin silently rotted several releases behind (v0.38.2/v1.0.4 while v1.1.2 was current), leaving every consumer, including autogov's own self-attestation, generating attestations with a stale CLI.",
      "matchPackageNames": [
        "liatrio/autogov"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "Pin floating references without delaying the security improvement",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "minimumReleaseAge": null
    }
  ],
  "schedule": [
    "before 5am every weekday"
  ],
  "labels": [
    "renovate",
    "gha"
  ]
}
