{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "autogov-version:[\\s\\S]*?default:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "liatrio/autogov",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "autogov-version`.*?default: '(?<currentValue>v\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "liatrio/autogov",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "extends": [
        ":semanticPrefixFixDepsChoreOthers",
        "helpers:pinGitHubActionDigests"
      ],
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "autogov-version bumps must be fix:-typed so they cut a release. The rw-* defaults only reach consumers via a release tag, so a chore:-typed bump merges to main and stops there -- which is how the pin silently rotted several releases behind (v0.38.2/v1.0.4 while v1.1.2 was current), leaving every consumer, including autogov's own self-attestation, generating attestations with a stale CLI.",
      "matchPackageNames": [
        "liatrio/autogov"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "Pin floating references without delaying the security improvement",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "minimumReleaseAge": null
    }
  ],
  "schedule": [
    "before 5am every weekday"
  ],
  "labels": [
    "renovate",
    "gha"
  ]
}
